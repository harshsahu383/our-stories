generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PURCHASER
  RECIPIENT
  ADMIN
}
enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}
enum RecordingStatus {
  UPLOADED
  TRANSCRIBING
  TRANSLATING
  REVIEW_PENDING
  SAVED
  FAILED
}
enum MemoryVisibility {
  PRIVATE
  FAMILY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole @default(RECIPIENT)
  preferredLanguage String @default("en")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     StorySession[]
  memories     Memory[]
  giftsCreated Gift[] @relation("GiftPurchaser")
  giftsReceived Gift[] @relation("GiftRecipient")
}

model Gift {
  id          String @id @default(cuid())
  code        String @unique
  purchaserId String
  recipientId String?
  activatedAt DateTime?
  createdAt   DateTime @default(now())
  purchaser   User @relation("GiftPurchaser", fields: [purchaserId], references: [id])
  recipient   User? @relation("GiftRecipient", fields: [recipientId], references: [id])
}

model Category {
  id        String @id
  sortOrder Int @default(0)
  questions Question[]
}

model Question {
  id          String @id @default(cuid())
  categoryId  String
  language    String
  text        String
  sortOrder   Int @default(0)
  isActive    Boolean @default(true)
  category    Category @relation(fields: [categoryId], references: [id])
  answers     StorySession[]
  @@unique([categoryId, language, sortOrder])
  @@index([categoryId, language, isActive])
}

model StorySession {
  id           String @id @default(cuid())
  userId       String
  questionId   String?
  language     String
  status       SessionStatus @default(ACTIVE)
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  user         User @relation(fields: [userId], references: [id])
  question     Question? @relation(fields: [questionId], references: [id])
  recordings   Recording[]
}

model Recording {
  id             String @id @default(cuid())
  sessionId      String
  originalAudioUrl String
  originalAudioKey String?
  mimeType       String
  durationSeconds Int?
  status         RecordingStatus @default(UPLOADED)
  originalTranscript String?
  englishTranslation String?
  detectedLanguage String?
  processingError String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  session        StorySession @relation(fields: [sessionId], references: [id])
  memory         Memory?
}

model Memory {
  id          String @id @default(cuid())
  userId      String
  recordingId String @unique
  title       String
  transcript  String
  translation String?
  visibility  MemoryVisibility @default(PRIVATE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id])
  recording   Recording @relation(fields: [recordingId], references: [id])
  @@index([userId, createdAt])
}
